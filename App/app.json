{
  "expo": {
    "name": "Chortle",
    "slug": "chortle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chortle",
    "userInterfaceStyle": "automatic",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "splash": {
      "backgroundColor": "#341B77",
      "resizeMode": "contain",
      "image": "./assets/images/splash-icon.png"
    },

    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.chortle.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Chortle needs access to your photos so you can post memes and set a profile picture.",
        "NSCameraUsageDescription": "Chortle uses your camera to take profile photos.",
        "NSMicrophoneUsageDescription": "Chortle may use the microphone for video memes."
      }
    },

    "android": {
      "package": "com.chortle.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#341B77"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA"
      ],
      "predictiveBackGestureEnabled": true
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#341B77",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Chortle needs access to your photos so you can post memes.",
          "cameraPermission": "Chortle uses your camera to take photos for memes."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#3D1B83",
          "androidMode": "default",
          "androidCollapsedTitle": "Chortle"
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
